# Neon Postgres connection string (pooled), one Neon branch per environment.
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
DATABASE_URL=

# Long random string used by Payload to sign sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Salt for the hash of a Visitor's IP address stored on Contact Submissions.
# Generate with: openssl rand -hex 32. Changing it breaks matching of old hashes.
IP_HASH_SALT=

# --- Contact Form email notification ---
# Each stored Contact Submission is emailed to CONTACT_NOTIFY_EMAIL through Resend.
# Leave either empty in development: nothing is sent (Payload logs emails to the console
# when RESEND_API_KEY is unset) and the Contact Form still works.
CONTACT_NOTIFY_EMAIL=
RESEND_API_KEY=
# Optional sender. Defaults to Resend's shared test sender, which only delivers to your own
# Resend account email; verify a domain in Resend and set this for real delivery.
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=

# --- Media storage ---
# Leave S3_BUCKET empty in development: uploads then go to ./media on local disk.
# Set all four in production and the demo to store uploads in Cloudflare R2
# (any S3-compatible bucket works). A partial setup refuses to start.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional; R2 ignores it. Defaults to "auto".
# S3_REGION=

# --- Seed data (pnpm seed) ---
# The first Editor created by the seed script, which only runs on an empty database.
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=

# --- Tests (copy these to .env.test, which is git-ignored) ---
# CI (.github/workflows/neon_workflow.yml) creates a Neon branch per pull request and uses its
# URL as TEST_DATABASE_URL. It reads TEST_EDITOR_EMAIL and TEST_EDITOR_PASSWORD from
# repository secrets, and needs the NEON_API_KEY secret and NEON_PROJECT_ID variable.
# A dedicated Neon branch used only by tests. Every run DELETES all documents in it,
# so it must never be the development or production branch (the test run refuses if it is).
# In .env.test this may also be written as DATABASE_URL=.
TEST_DATABASE_URL=
# Credentials for the Editor that every test run seeds. Use throwaway values.
TEST_EDITOR_EMAIL=editor@example.test
TEST_EDITOR_PASSWORD=
# Optional: signing secret for the app under test. Defaults to a fixed test-only value.
# TEST_PAYLOAD_SECRET=
