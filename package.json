{
  "name": "next-starter-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "payload",
    "seed": "payload run scripts/seed.ts",
    "publish-homepage": "payload run scripts/publish-homepage.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:int": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "graphql": "17.0.2",
    "negotiator": "1.1.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/negotiator": "0.6.5",
    "@types/node": "^26",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
